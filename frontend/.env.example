# Frontend environment. Copy to `.env.local` for local work; never commit the
# copy. Every variable here is PUBLIC - Vite inlines it into the built JS, so it
# must never hold a secret.

# Base URL of the Express API, including the /api prefix.
#
#   local development -> leave unset. Vite's dev server proxies /api and
#                         /uploads to http://localhost:5000, so the browser
#                         stays on a single origin.
#
#   production (Netlify)-> https://<your-api>.onrender.com/api
#
# This is also used to resolve stored upload paths (/uploads/...) to an absolute
# URL on the API origin, which is required because the site and the API are
# served from different hosts.
VITE_API_BASE_URL=