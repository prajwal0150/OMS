# Dependencies
node_modules/

# Build output
dist/
build/

# Environment files (never commit real secrets)
.env
.env.local
.env.*.local
# dotenvx writes encrypted key material next to the .env file under its own
# name. It is a secret and was committed once already (e09f417), so it needs an
# explicit rule: the patterns above match ".env" and ".env.<something>.local"
# but not ".env.keys".
.env.keys
.env.*.keys

# Logs and diagnostics
*.log
npm-debug.log*
vitest-*.log

# Uploaded media (the running API writes here)
backend/uploads/

# Editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
# Generated by tools/verify-deploy-config.mjs on every run
deploy-report.txt
