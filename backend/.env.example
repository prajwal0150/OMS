# ---- Runtime ----
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/hps_oms
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/hps_oms_test

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- Client ----
CLIENT_URL=http://localhost:5173

# ---- Seed (initial Super Admin: created only when no Super Admin exists) ----
SUPER_ADMIN_EMAIL=superadmin@heavenlypath.org
SUPER_ADMIN_PASSWORD=ChangeMe@2026
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SEED_DEMO_DATA=true

# Re-hash SUPER_ADMIN_PASSWORD onto an EXISTING Super Admin, clearing any
# lockout. Needed whenever you forget the password, because a plain re-run of
# the seed leaves an existing account untouched. Leave false for normal
# re-runs so the seed cannot overwrite a password you have already changed.
RESET_SUPER_ADMIN_PASSWORD=false

# ---- Storage ----
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=100
MAX_DOCUMENT_SIZE_MB=25
